<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name NoteAPI_GUI_Test.ui -->
  <!-- interface-description I have NotePadAPI here and i need a gui for it to test easier -->
  <requires lib="gio" version="2.0"/>
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwWindow" id="window_id">
    <child>
      <object class="GtkBox">
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkSearchBar">
                <property name="height-request">31</property>
                <property name="margin-top">13</property>
                <property name="search-mode-enabled">True</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="halign">baseline</property>
                <property name="height-request">20</property>
                <property name="valign">start</property>
                <child>
                  <object class="GtkButton" id="lastcreated_button">
                    <property name="label">/lastcreated</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="getnotes_button">
                    <property name="label">/getnotes</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwClampScrollable">
                <property name="maximum-size">300</property>
                <child>
                  <object class="GtkListBox">
                    <property name="css-classes">boxed-list</property>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="height-request">80</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkBox">
                                <property name="valign">center</property>
                                <property name="vexpand">True</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="justify">center</property>
                                    <property name="label">notename</property>
                                    <property name="margin-start">10</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="halign">end</property>
                                    <property name="hexpand">True</property>
                                    <property name="icon-name">ephy-non-starred-symbolic</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Open</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">noteowner</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkMenuButton">
                                    <property name="halign">end</property>
                                    <property name="hexpand">True</property>
                                    <property name="menu-model">
                                      <menu>
                                        <item>
                                          <attribute name="icon">edit-clear-symbolic</attribute>
                                          <attribute name="label">Delete</attribute>
                                        </item>
                                        <item>
                                          <attribute name="label">Duplicate</attribute>
                                        </item>
                                      </menu>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkTextView" id="text_output">
                <property name="editable">False</property>
                <property name="height-request">200</property>
                <property name="pixels-below-lines">5</property>
                <property name="wrap-mode">word</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox">
                <property name="margin-end">20</property>
                <property name="margin-start">20</property>
                <child>
                  <object class="GtkLabel" id="note_title_edit">
                    <property name="label">notename</property>
                    <property name="margin-end">20</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="favorited_note">
                    <property name="halign">end</property>
                    <property name="hexpand">True</property>
                    <property name="icon-name">emblem-favorite-symbolic</property>
                    <property name="margin-start">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkTextView">
                <property name="css-classes">boxed-list</property>
                <property name="height-request">300</property>
                <property name="margin-bottom">10</property>
                <property name="margin-end">10</property>
                <property name="margin-start">10</property>
                <property name="margin-top">10</property>
                <property name="width-request">350</property>
                <property name="wrap-mode">word</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
